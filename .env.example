# DingTalk internal app credentials
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# Required by wiki APIs. Fill the operatorId expected by DingTalk wiki APIs.
DINGTALK_OPERATOR_ID=

# Optional. Comma-separated wiki workspace ids. Leave blank to try listing accessible workspaces.
DINGTALK_WIKI_WORKSPACE_IDS=

# Optional. Comma-separated DingTalk user ids whose reports should be synced.
DINGTALK_REPORT_USER_IDS=

# Optional. Report template names, comma-separated. Example: 日报,周报
DINGTALK_REPORT_TEMPLATE_NAMES=

# Sync window for reports when no explicit date range is provided.
SYNC_LOG_DAYS=14

# Optional exact report date range, Asia/Shanghai local dates.
SYNC_LOG_START_DATE=
SYNC_LOG_END_DATE=

# Output behavior
SYNC_OUTPUT_DIR=data
SYNC_DOCS_DIR=docs

# Set to true after Doc content permission is approved. This may sync many files.
SYNC_WIKI_CONTENT=false

# Optional PDF export fallback for unsupported DingTalk blocks.
PDF_OUTPUT_DIR=docs/wiki-pdf
DINGTALK_BROWSER_PROFILE_DIR=.auth/dingtalk-browser
PDF_MAX_DOCS=10
PDF_WORKSPACE_ID=

# Optional OAuth user-delegated token exchange.
# Fill exactly one of DINGTALK_AUTH_CODE or DINGTALK_USER_REFRESH_TOKEN.
DINGTALK_AUTH_CODE=
DINGTALK_USER_REFRESH_TOKEN=
